---
import Default from '@astrojs/starlight/components/PageTitle.astro';

const { id } = Astro.locals.starlightRoute;
const isPlusEditionLanding = id === 'plus-edition' || id.endsWith('/plus-edition');
---

{
	isPlusEditionLanding ? (
		<>
			<div data-plus-title-placeholder></div>
			<style is:global>
				.content-panel:has([data-plus-title-placeholder]) {
					display: none;
				}
			</style>
		</>
	) : (
		<Default />
	)
}
